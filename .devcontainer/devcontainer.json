{
	"name": "pyrcf",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"postCreateCommand": "pip install --upgrade pip && pip install -e '.[test,docs]'",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"ms-python.black-formatter",
				"charliermarsh.ruff",
				"tamasfe.even-better-toml"
			]
		}
	}
}
